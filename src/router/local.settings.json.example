{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AGENT_BASE_URL": "http://localhost:7071/api",
    "DATA_CONTAINER": "data",
    "RESULTS_CONTAINER": "results"
